{
  "name": "godnsweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 14200",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "preview": "vite preview"
